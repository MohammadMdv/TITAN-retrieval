# Copy to .env and fill in. validation/common.py loads HF_TOKEN from here if it isn't
# already set in the environment.
HF_TOKEN=

# Optional overrides (see validation/common.py for defaults):
# CAMELYON16_ROOT=/path/to/CAMELYON16          # h5_files/conch_v1_5/*.h5 + reference.csv
# VALIDATION_RESULTS_DIR=/path/to/results/dir  # defaults to validation/results
# PATHSEARCH_QUERY_CSV=/path/to/camelyon16_query_results.csv  # only for retrieval_camelyon16.py

# BRACS (validation/download_bracs.py). Register at https://www.bracs.icar.cnr.it/
# to receive FTP credentials; there is no public mirror.
# BRACS_FTP_HOST=
# BRACS_FTP_USER=
# BRACS_FTP_PASS=
# BRACS_WSI_DIR=/path/on/server        # only if auto-detection of the WSI dir fails
# BRACS_ROOT=/path/to/local/BRACS      # defaults to ./data/BRACS
# DISK_BUDGET_GB=150                   # cap on the downloaded WSI subset
# MIN_PER_CLASS=5                      # min slides per lesion class per split
